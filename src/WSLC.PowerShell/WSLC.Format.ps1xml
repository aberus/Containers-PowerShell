<?xml version="1.0" encoding="utf-8"?>
<Configuration>
	<ViewDefinitions>
		<View>
			<Name>Container</Name>
			<ViewSelectedBy>
				<TypeName>Microsoft.WSL.Containers.Container</TypeName>
			</ViewSelectedBy>
			<TableControl>
				<TableHeaders>
					<TableColumnHeader>
						<Label>ID</Label>
						<Width>12</Width>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>Name</Label>
						<Width>25</Width>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>State</Label>
						<Width>10</Width>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>InitPid</Label>
						<Width>10</Width>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>Session</Label>
						<Width>30</Width>
					</TableColumnHeader>
				</TableHeaders>
				<TableRowEntries>
					<TableRowEntry>
						<TableColumnItems>
							<TableColumnItem>
								<ScriptBlock>[WSLC.PowerShell.Support.Formatter]::TruncateId($_.Id)</ScriptBlock>
							</TableColumnItem>
							<TableColumnItem>
								<ScriptBlock>[WSLC.PowerShell.Support.Formatter]::ContainerName($_)</ScriptBlock>
							</TableColumnItem>
							<TableColumnItem>
								<PropertyName>State</PropertyName>
							</TableColumnItem>
							<TableColumnItem>
								<ScriptBlock>try { $_.InitProcess.Pid } catch { '' }</ScriptBlock>
							</TableColumnItem>
							<TableColumnItem>
								<ScriptBlock>[WSLC.PowerShell.Support.Formatter]::ContainerSessionName($_)</ScriptBlock>
							</TableColumnItem>
						</TableColumnItems>
					</TableRowEntry>
				</TableRowEntries>
			</TableControl>
		</View>
		<View>
			<Name>ContainerImage</Name>
			<ViewSelectedBy>
				<TypeName>Microsoft.WSL.Containers.ImageInfo</TypeName>
			</ViewSelectedBy>
			<TableControl>
				<TableHeaders>
					<TableColumnHeader>
						<Label>Name</Label>
						<Width>40</Width>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>ID</Label>
						<Width>14</Width>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>Created</Label>
						<Width>22</Width>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>Size(MB)</Label>
						<Width>12</Width>
						<Alignment>Right</Alignment>
					</TableColumnHeader>
				</TableHeaders>
				<TableRowEntries>
					<TableRowEntry>
						<TableColumnItems>
							<TableColumnItem>
								<PropertyName>Name</PropertyName>
							</TableColumnItem>
							<TableColumnItem>
								<ScriptBlock>[WSLC.PowerShell.Support.Formatter]::ImageId($_)</ScriptBlock>
							</TableColumnItem>
							<TableColumnItem>
								<ScriptBlock>'{0:g}' -f $_.CreatedTimestamp.LocalDateTime</ScriptBlock>
							</TableColumnItem>
							<TableColumnItem>
								<ScriptBlock>'{0:N2}' -f ($_.Size/1MB)</ScriptBlock>
							</TableColumnItem>
						</TableColumnItems>
					</TableRowEntry>
				</TableRowEntries>
			</TableControl>
		</View>
		<View>
			<Name>ContainerSession</Name>
			<ViewSelectedBy>
				<TypeName>Microsoft.WSL.Containers.Session</TypeName>
			</ViewSelectedBy>
			<TableControl>
				<TableHeaders>
					<TableColumnHeader>
						<Label>Name</Label>
						<Width>40</Width>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>Containers</Label>
						<Width>12</Width>
						<Alignment>Right</Alignment>
					</TableColumnHeader>
				</TableHeaders>
				<TableRowEntries>
					<TableRowEntry>
						<TableColumnItems>
							<TableColumnItem>
								<ScriptBlock>[WSLC.PowerShell.Support.Formatter]::SessionName($_)</ScriptBlock>
							</TableColumnItem>
							<TableColumnItem>
								<ScriptBlock>[WSLC.PowerShell.Support.Formatter]::SessionContainerCount($_)</ScriptBlock>
							</TableColumnItem>
						</TableColumnItems>
					</TableRowEntry>
				</TableRowEntries>
			</TableControl>
		</View>
		<View>
			<Name>ContainerProcess</Name>
			<ViewSelectedBy>
				<TypeName>Microsoft.WSL.Containers.Process</TypeName>
			</ViewSelectedBy>
			<TableControl>
				<TableHeaders>
					<TableColumnHeader>
						<Label>Pid</Label>
						<Width>10</Width>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>State</Label>
						<Width>12</Width>
					</TableColumnHeader>
					<TableColumnHeader>
						<Label>ExitCode</Label>
						<Width>10</Width>
						<Alignment>Right</Alignment>
					</TableColumnHeader>
				</TableHeaders>
				<TableRowEntries>
					<TableRowEntry>
						<TableColumnItems>
							<TableColumnItem>
								<PropertyName>Pid</PropertyName>
							</TableColumnItem>
							<TableColumnItem>
								<PropertyName>State</PropertyName>
							</TableColumnItem>
							<TableColumnItem>
								<ScriptBlock>if ($_.State -eq 'Exited' -or $_.State -eq 'Signalled') { $_.ExitCode } else { '' }</ScriptBlock>
							</TableColumnItem>
						</TableColumnItems>
					</TableRowEntry>
				</TableRowEntries>
			</TableControl>
		</View>
	</ViewDefinitions>
</Configuration>
